FROM golang:1.23 AS build

WORKDIR /src
COPY csi/go.mod csi/go.sum ./
RUN go mod download
COPY csi/ ./
RUN CGO_ENABLED=0 go build -trimpath -o /out/railfs-csi .

FROM ubuntu:24.04

RUN apt-get update && apt-get install -y --no-install-recommends \
      kmod \
      util-linux \
    && rm -rf /var/lib/apt/lists/*

COPY --from=build /out/railfs-csi /usr/local/bin/railfs-csi

ENTRYPOINT ["/usr/local/bin/railfs-csi"]
